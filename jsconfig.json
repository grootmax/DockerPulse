{
  "compilerOptions": {
    "target": "es2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "useUnknownInCatchVariables": false
  },
  "include": [
    "declarations.d.ts",
    "processRegistry.js",
    "eventManager.js"
  ],
  "exclude": [
    "node_modules",
    "build_staging"
  ]
}
